{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/youtube-title/:videoId",
      "destination": "https://www.youtube.com/oembed?format=json&url=https://youtu.be/:videoId"
    },
    {
      "source": "/api/noembed-title/:videoId",
      "destination": "https://noembed.com/embed?url=https://youtu.be/:videoId"
    }
  ]
}
